# dr.spark_alarm 환경변수 예시. `cp .env.example .env` 후 값을 채운다(.env는 git에 올리지 않는다).
# Docker: compose.yaml이 .env를 읽는다. systemd: deploy/drspark-alarm.service의 EnvironmentFile로 읽는다.
# 직접 실행할 때는 `set -a; . ./.env; set +a`로 읽는다(source.py는 .env를 스스로 읽지 않는다).
# <, &, 공백이 들어간 값은 큰따옴표로 감싼다(docker compose·systemd·bash 모두 따옴표를 벗겨 읽는다).
# 값을 비워 둔 줄(VAR=)은 설정하지 않은 것으로 보고 기본값을 쓴다.

# Discord 웹후크 주소(필수). 비어 있으면 새 글을 DB에 기록만 하고 알림은 보내지 않는다(경고 로그).
DISCORD_WEBHOOK_URL=

# 알림 범위
#   all   : 모든 새 글(기본, 기존 동작과 같음)
#   deals : 저평가(신뢰 높음·보통) 또는 같은 판매자가 5% 이상 내려 적정가(P50) 이하가 된 재게시만
#           (적정가가 없는 묶음 글 등은 10% 이상 내린 것만)
#   모르는 값이면 시작할 때 경고를 남기고 all로 동작한다.
ALERT_MODE=all

# 알림 받을 카테고리(쉼표로 구분, 대소문자 무관, 비우면 전체)
#   ski, boots, binding, snowboard, apparel, gloves, helmet, goggle, protector, poles, bag, tuning, other
#   예: ALERT_CATEGORIES=ski,boots
#   모르는 값은 시작할 때 경고를 남기고 무시한다(남는 값이 없으면 전체 알림).
ALERT_CATEGORIES=

# 1이면 구매 희망 글(삽니다)은 알리지 않는다(기본 0)
ALERT_SKIP_WANTED=0

# 저평가 알림에 붙일 멘션(비우면 멘션 없음). 예: DEAL_MENTION=@here 또는 DEAL_MENTION="<@&역할ID>"
DEAL_MENTION=

# Discord 전송에 실패한 알림을 다시 보내는 기간(시간, 기본 6). 이보다 오래 못 보낸 알림은 버린다.
# ALERT_RETRY_HOURS=6

# 적정가 보강 켜기(1, 기본)/끄기(0). 0이면 기존 알림과 똑같이 동작한다.
DRSPARK_PRICING=1

# 사전·모델 폴더(기본: 저장소의 pricing_data/). 다른 위치의 번들을 쓸 때만 주석을 풀고 경로를 넣는다.
# DRSPARK_PRICING_DIR=/opt/dr.spark_alarm/pricing_data

# (선택) SQLite DB 경로. 기본은 실행 폴더의 drspark_seen.db. Docker에서는 compose.yaml 값(/app/data/drspark_seen.db)이 우선한다.
# DRSPARK_DB=/opt/dr.spark_alarm/data/drspark_seen.db

# (선택, Docker 빌드용) 컨테이너 사용자 UID/GID. ./data 소유자와 맞춘다(기본 1000)
# APP_UID=1000
# APP_GID=1000
